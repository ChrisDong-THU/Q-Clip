    "version": "0.2.0",
    "configurations": [
        {
            "name": "Training Q-Clip",
            "type": "debugpy",
            "request": "launch",
            "program": "./qclip/train.py",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
                "WANDB_MODE": "offline",
                "PROJECT": "qclip"
            },
            "args": [
                "-c", "debug",
                "--exp", "debug"
            ]
          },
    ]
}